{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DCP for omp config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean" },
    "debug": { "type": "boolean" },
    "pruneNotification": { "enum": ["off", "minimal", "detailed"] },
    "pruneNotificationType": { "enum": ["chat", "toast"] },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "protectedTools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "manualMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "automaticStrategies": { "type": "boolean" }
      }
    },
    "turnProtection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "turns": { "type": "integer", "minimum": 1 }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowSubAgents": { "type": "boolean" },
        "customPrompts": { "type": "boolean" }
      }
    },
    "protectedFilePatterns": { "type": "array", "items": { "type": "string" } },
    "compress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["range", "message"] },
        "permission": { "enum": ["ask", "allow", "deny"] },
        "showCompression": { "type": "boolean" },
        "summaryBuffer": { "type": "boolean" },
        "maxContextLimit": { "type": ["number", "string"], "pattern": "^\\d+%$" },
        "minContextLimit": { "type": ["number", "string"], "pattern": "^\\d+%$" },
        "modelMaxLimits": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
        "modelMinLimits": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
        "nudgeFrequency": { "type": "number", "minimum": 1 },
        "iterationNudgeThreshold": { "type": "number", "minimum": 0 },
        "nudgeForce": { "enum": ["strong", "soft"] },
        "protectedTools": { "type": "array", "items": { "type": "string" } },
        "protectTags": { "type": "boolean" },
        "protectUserMessages": { "type": "boolean" }
      }
    },
    "strategies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deduplication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "protectedTools": { "type": "array", "items": { "type": "string" } }
          }
        },
        "purgeErrors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "turns": { "type": "integer", "minimum": 1 },
            "protectedTools": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
